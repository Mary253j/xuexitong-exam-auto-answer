<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.local.quizhelper" android:versionCode="13" android:versionName="1.0.12">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.chaoxing.mobile" /></queries>
    <application android:name=".AppState" android:label="题页助手"
        android:icon="@drawable/ic_app" android:theme="@style/AppTheme"
        android:allowBackup="false" android:fullBackupContent="false"
        android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true" android:debuggable="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WebActivity" android:exported="false" />
        <service android:name=".QuizService" android:exported="true"
            android:label="题页助手 · 学习通页面操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
